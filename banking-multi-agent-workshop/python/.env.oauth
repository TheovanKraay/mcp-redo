# MCP Banking Server Authentication Configuration
# 
# This server supports two authentication modes:
# 1. SIMPLE TOKEN (default) - works out of the box for development
# 2. GITHUB OAUTH (production) - secure OAuth flow for production use

# ===== SIMPLE TOKEN AUTHENTICATION (DEFAULT) =====
# This is enabled by default and requires no setup
# Change this token to something secure for your environment
MCP_AUTH_TOKEN=banking-server-dev-token-2024

# ===== GITHUB OAUTH AUTHENTICATION (PRODUCTION) =====
# To enable GitHub OAuth instead of simple token:
# 1. Go to https://github.com/settings/applications/new
# 2. Application name: "MCP Banking Server"  
# 3. Homepage URL: http://localhost:8000 (or your domain)
# 4. Authorization callback URL: http://localhost:8000/auth/github/callback
# 5. Uncomment and fill in the values below:

# GITHUB_CLIENT_ID=your_github_client_id_here
# GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ===== SERVER CONFIGURATION =====
MCP_SERVER_BASE_URL=http://localhost:8000

# ===== AUTHENTICATION LOGIC =====
# The server will automatically:
# - Use GitHub OAuth if GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are set
# - Fall back to simple token authentication if GitHub credentials are not configured
# - Run without authentication if MCP_AUTH_TOKEN is empty or commented out
OAUTH_REGISTRATION_ENDPOINT=http://localhost:8080/auth/register

# OAuth Scopes
OAUTH_SCOPES=read,write,banking:access

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_SERVER_BASE_URL=http://localhost:8000

# Redirect URIs
OAUTH_REDIRECT_URI=http://localhost:8000/mcp/oauth/callback