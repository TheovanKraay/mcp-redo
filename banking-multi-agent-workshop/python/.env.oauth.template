# FastMCP OAuth Configuration Template
# Copy this to .env.oauth and fill in your values

# ===== GitHub OAuth Configuration =====
# Register a GitHub OAuth App at: https://github.com/settings/applications/new
# Set Authorization callback URL to: http://localhost:8000/auth/github/callback

GITHUB_CLIENT_ID=your_github_oauth_app_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret_here

# ===== MCP Server Configuration =====
# The base URL where your MCP server will be accessible
MCP_SERVER_BASE_URL=http://localhost:8000

# ===== Alternative OAuth Providers =====
# Uncomment and configure if using other providers instead of GitHub

# Google OAuth (requires Google Cloud Console setup)
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Token Verification (if using existing JWT infrastructure)
# JWT_JWKS_URI=https://your-auth-system.com/.well-known/jwks.json
# JWT_ISSUER=https://your-auth-system.com
# JWT_AUDIENCE=mcp-server

# WorkOS AuthKit (enterprise-grade auth)
# AUTHKIT_DOMAIN=https://your-project.authkit.app
# WORKOS_API_KEY=your_workos_api_key